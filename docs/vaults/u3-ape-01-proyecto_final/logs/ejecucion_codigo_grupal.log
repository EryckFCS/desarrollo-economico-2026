(46,463 missing values generated)

. 
. forvalues d = 0(10)100 {
  2.     
.     local fila = (`d'/10) + 1
  3.     
.     replace decil = `d'/10 in `fila'
  4.     replace poblacion_decil = `d' in `fila'
  5.     
.     if `d' == 0 {
  6.         replace ingreso_decil = 0 in `fila'
  7.     }
  8.     else {
  9.         quietly summ y_ingreso if x_poblacion >= `d'
 10.         replace ingreso_decil = r(min) in `fila'
 11.     }
 12.     
.     replace etiqueta = string(ingreso_decil, "%4.2f") + "%" in `fila'
 13. }
